# Caddy obtains and renews the HTTPS certificate for {$DOMAIN} automatically.
{$DOMAIN} {
	encode zstd gzip

	# Gallery uploads: up to 6 photos × 10 MB per request.
	request_body {
		max_size 70MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}

	reverse_proxy app:3000
}

# Uncomment once a DNS record for www exists:
# www.{$DOMAIN} {
# 	redir https://{$DOMAIN}{uri} permanent
# }
