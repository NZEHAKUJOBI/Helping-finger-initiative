# Public URL of the deployed site (used for metadata and sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin area (/admin)
ADMIN_PASSWORD=change-me
# 32+ random characters, e.g. `openssl rand -base64 48`
SESSION_SECRET=

# Where uploaded gallery images are stored. Must be persistent disk in production.
# STORAGE_DIR=/var/lib/helping-fingers
